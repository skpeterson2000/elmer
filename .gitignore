# Your progress, not the app's
data/elmer.db
data/elmer.db-journal
data/elmer.db-wal
data/elmer.db-shm
data/elmer.log
data/server-console.log
data/explanations/

# Read out of the current NIFOG on demand. It is a public document and freely
# reproducible, but it is CISA's to revise, so ELMER keeps a copy rather than
# a fork of it.
data/nifog/

# What the update check last saw. Writing it must never make the install look
# modified, or it would block the very update it exists to announce.
data/update.json

# Throwaway browser profile made by --kiosk
data/kiosk-profile/

# Lookup caches. Keyed by where you are and where you have looked,
# so they are yours rather than the app's.
data/geocode/
data/terrain/
data/regional/
data/callsign/
data/ionosonde/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Generated documents: the RF exposure record and band chart are produced on
# demand, so a copy landing in the working directory is an artefact, not source.
/*.pdf

# Editors / OS
.DS_Store
*.swp
.idea/
.vscode/
