# Your progress, not the app's
data/elmer.db
data/elmer.db-journal
data/elmer.db-wal
data/elmer.db-shm
data/elmer.log
data/elmer.log.*
data/server-console.log
data/explanations/

# Read out of the current NIFOG on demand. It is a public document and freely
# reproducible, but it is CISA's to revise, so ELMER keeps a copy rather than
# a fork of it.
data/nifog/

# Towns fetched for wherever this station is. The bundled data/places.json is
# the fallback and is committed; this is what the network filled in.
data/places/

# What the update check last saw. Writing it must never make the install look
# modified, or it would block the very update it exists to announce.
data/update.json

# Throwaway browser profile made by --kiosk
data/kiosk-profile/

# Lookup caches. Keyed by where you are and where you have looked,
# so they are yours rather than the app's.
data/geocode/
data/terrain/
data/callsign/
# Awards fetched by callsign. Public where they came from, and still not
# something one operator's unit should carry into everybody else's checkout.
data/pota/
data/regional/
data/callsign/
data/ionosonde/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Generated documents: the RF exposure record and band chart are produced on
# demand, so a copy landing in the working directory is an artefact, not source.
/*.pdf

# The shelf of things this unit has printed. Every one of them is rebuilt by
# the button that made it, so it is output rather than anybody's data - but it
# is this operator's output, and it is not the app's.
data/prints/

# Editors / OS
.DS_Store
*.swp
.idea/
.vscode/

# Repeaters imported from TowerWitch or a RepeaterBook export. Yours, keyed
# to where you are, so it is not the app's to ship.
data/repeaters.json

# Problem reports written by --report. They are generated, and may carry
# whatever the operator chose to leave in them.
data/elmer-report-*.txt

# Places prepared for a trip. Where somebody is going is theirs, not the
# application's.
data/trips.json
